{
  "manifest_version": 3,
  "name": "CatchUp Universal",
  "version": "0.1.0",
  "description": "Summarize chat text from user-selected ZIP files and screenshots locally.",
  "permissions": ["storage", "sidePanel"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "options_page": "options.html",
  "action": { "default_title": "Open CatchUp" },
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'" }
}
